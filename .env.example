# LLM Configuration
# Options: 'groq', 'gemini', or 'mock'
LLM_PROVIDER=groq
# Default models:
# For Groq: llama-3.3-70b-versatile or llama-3.1-8b-instant
# For Gemini: gemini-1.5-flash or gemini-2.5-flash
LLM_MODEL=llama-3.3-70b-versatile

# Provider API Keys
GROQ_API_KEY=
GOOGLE_API_KEY=

# Search Provider Configuration
# Options: 'duckduckgo' or 'mock'
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# General Configuration
DEFAULT_LOOKBACK_DAYS=90
REQUEST_TIMEOUT_SECONDS=15
MAX_SEARCH_RESULTS=5
CACHE_ENABLED=true
OUTPUT_DIR=runs
